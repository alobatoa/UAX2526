<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="grafica.experiencial.view.PrincipalController"
            prefWidth="900.0"
            prefHeight="500.0">

    <top>
        <VBox spacing="12.0" style="-fx-padding: 15;">
            <HBox spacing="8.0" alignment="CENTER_LEFT">
                <Label text="Buscar por nombre:"/>

                <TextField fx:id="txtBusqueda"
                           promptText="Escribe el nombre del producto..."
                           prefWidth="250.0"/>
            </HBox>

            <HBox spacing="8.0">
                <Button text="Mostrar todos"
                        onAction="#mostrarTodos"/>

                <Button text="Filtrar precio &lt; 600"
                        onAction="#filtrar600"/>

                <Button text="Ir a Gestión"
                        onAction="#irAGestion"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tabla"
                   BorderPane.alignment="CENTER"/>
    </center>

</BorderPane>
