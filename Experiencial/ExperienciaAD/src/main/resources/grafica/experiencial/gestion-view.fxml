<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="500.0" prefWidth="1056.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="grafica.experiencial.view.GestionController">

<top>
    <VBox spacing="10.0" style="-fx-padding: 15;">

        <HBox spacing="8.0">
            <Button onAction="#mostrarProductosMenores600" text="Productos precio &lt; 600" />

            <Button onAction="#insertarFavoritos" prefHeight="25.0" prefWidth="177.0" text="Insertar productos &gt; 1000 en favoritos" />
           <HBox prefHeight="0.0" prefWidth="536.0" spacing="8.0">
               <Button onAction="#mostrarEmpleados" text="Mostrar empleados" />
   
               <Button onAction="#mostrarProductos" text="Mostrar productos" />
   
               <Button onAction="#mostrarPedidos" text="Mostrar pedidos" />
           </HBox>

            <Button fx:id="btnVolver" onAction="#volver" text="Volver" />
        </HBox>
    </VBox>
</top>

<center>
    <TableView fx:id="tabla" prefHeight="445.0" prefWidth="690.0" BorderPane.alignment="CENTER" />
</center>

</BorderPane>
